{
  "redirects": [
    { "source": "/ko", "destination": "/", "permanent": true },
    { "source": "/ko/", "destination": "/", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy", "permanent": true },
    { "source": "/terms/", "destination": "/terms", "permanent": true }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },

    { "source": "/:lang(en|ja|zh)", "destination": "/:lang/index.html" },
    { "source": "/:lang(en|ja|zh)/", "destination": "/:lang/index.html" },

    { "source": "/background-remover", "destination": "/background-remover/index.html" },
    { "source": "/background-remover/", "destination": "/background-remover/index.html" },
    { "source": "/:lang(en|ja|zh)/background-remover", "destination": "/:lang/background-remover/index.html" },
    { "source": "/:lang(en|ja|zh)/background-remover/", "destination": "/:lang/background-remover/index.html" },

    { "source": "/:tool(ai-sticker-maker|photo-to-sticker|sticker-sheet-splitter|transparent-png-maker|image-upscaler)", "destination": "/:tool/index.html" },
    { "source": "/:tool(ai-sticker-maker|photo-to-sticker|sticker-sheet-splitter|transparent-png-maker|image-upscaler)/", "destination": "/:tool/index.html" },
    { "source": "/:lang(en|ja|zh)/:tool(ai-sticker-maker|photo-to-sticker|sticker-sheet-splitter|transparent-png-maker|image-upscaler)", "destination": "/:lang/:tool/index.html" },
    { "source": "/:lang(en|ja|zh)/:tool(ai-sticker-maker|photo-to-sticker|sticker-sheet-splitter|transparent-png-maker|image-upscaler)/", "destination": "/:lang/:tool/index.html" }
  ]
}
